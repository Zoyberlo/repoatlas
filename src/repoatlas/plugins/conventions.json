{
  "version": 1,
  "note": [
    "Framework conventions, as data.",
    "",
    "A convention says that a string in one file names another file, and no",
    "parser can see it. Laravel's view('users.index') is",
    "resources/views/users/index.blade.php. A Quasar template's <UserCard />",
    "with no import beside it is src/components/UserCard.vue, wherever under",
    "that directory it happens to sit.",
    "",
    "Every rule is checked the same way: build the paths the convention",
    "allows and claim an edge only for one that is really in the repository.",
    "A rule that names nothing produces no edge, never a guess.",
    "",
    "Adding a framework is editing this file. The fields are described in",
    "registry.py, which is the only code that reads it."
  ],
  "frameworks": [
    {
      "name": "laravel",
      "summary": "Blade views, layouts, partials and components.",
      "detect": [
        {
          "file": "composer.json",
          "fields": ["require", "require-dev"],
          "packages": [
            "laravel/framework",
            "laravel/lumen-framework",
            "illuminate/view",
            "illuminate/support"
          ]
        }
      ],
      "rules": [
        {
          "kinds": ["view", "extends", "include"],
          "languages": ["php", "blade"],
          "separator": ".",
          "reject": ["::"],
          "candidates": [
            {
              "root": "resources/views",
              "path": "{path}",
              "suffixes": [".blade.php", ".blade.phtml", ".php"]
            }
          ]
        },
        {
          "kinds": ["component"],
          "languages": ["blade"],
          "prefix": "x-",
          "separator": ".",
          "candidates": [
            {
              "root": "resources/views/components",
              "path": "{path}",
              "suffixes": [".blade.php", ".blade.phtml", ".php"]
            },
            {
              "root": "resources/views/components",
              "path": "{path}/index",
              "suffixes": [".blade.php", ".blade.phtml", ".php"]
            },
            {
              "root": "app/View/Components",
              "path": "{studly}",
              "suffixes": [".php"]
            }
          ]
        },
        {
          "kinds": ["component"],
          "languages": ["blade"],
          "prefix": "livewire:",
          "separator": ".",
          "candidates": [
            {"root": "app/Livewire", "path": "{studly}", "suffixes": [".php"]},
            {"root": "app/Http/Livewire", "path": "{studly}", "suffixes": [".php"]},
            {
              "root": "resources/views/livewire",
              "path": "{path}",
              "suffixes": [".blade.php"]
            }
          ]
        }
      ]
    },
    {
      "name": "vue",
      "summary": "Components a template uses without importing them.",
      "detect": [
        {
          "file": "package.json",
          "fields": ["dependencies", "devDependencies"],
          "packages": ["vue", "quasar", "@quasar/app-vite", "@quasar/app-webpack", "nuxt"]
        }
      ],
      "rules": [
        {
          "kinds": ["component"],
          "languages": ["vue"],
          "separator": "",
          "reject_prefix": ["q-", "el-", "van-", "router-", "keep-", "transition-"],
          "candidates": [
            {"under": "src/components", "stem": "{studly}", "suffixes": [".vue"]},
            {"under": "src/layouts", "stem": "{studly}", "suffixes": [".vue"]},
            {"under": "src/pages", "stem": "{studly}", "suffixes": [".vue"]},
            {"under": "components", "stem": "{studly}", "suffixes": [".vue"]}
          ]
        }
      ]
    }
  ]
}
